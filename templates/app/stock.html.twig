{% extends 'base.html.twig' %}

{% block title %}{{ 'stock.title'|trans }} - SIM Auto{% endblock %}

{% block body %}
{% include 'app/_topbar.html.twig' with {user: user} %}

<main class="main-board">
    <section class="page-head">
        <h1>{{ 'stock.title'|trans }}</h1>
        <a class="btn btn-dark" href="{{ path('app_dashboard') }}">{{ 'ui.back'|trans }}</a>
    </section>

    {% for message in app.flashes('success') %}<div class="alert alert-success">{{ message|trans }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="alert alert-error">{{ message|trans }}</div>{% endfor %}

    <section class="panel">
        <form method="get" class="form-grid">
            <label>{{ 'stock.period'|trans }}<select name="preset"><option value="today" {{ stock_filters.preset == 'today' ? 'selected' : '' }}>{{ 'reports.preset.today'|trans }}</option><option value="week" {{ stock_filters.preset == 'week' ? 'selected' : '' }}>{{ 'reports.preset.week'|trans }}</option><option value="month" {{ stock_filters.preset == 'month' ? 'selected' : '' }}>{{ 'reports.preset.month'|trans }}</option><option value="custom" {{ stock_filters.preset == 'custom' ? 'selected' : '' }}>{{ 'reports.preset.custom'|trans }}</option></select></label>
            <label>{{ 'reports.date_from'|trans }}<input type="date" name="from" value="{{ stock_filters.from }}"></label>
            <label>{{ 'reports.date_to'|trans }}<input type="date" name="to" value="{{ stock_filters.to }}"></label>
            <label>{{ 'products.category'|trans }}<select name="category_id"><option value="0">{{ 'ui.all'|trans }}</option>{% for category in categories %}<option value="{{ category.id }}" {{ stock_filters.category_id == category.id ? 'selected' : '' }}>{{ category.name }}</option>{% endfor %}</select></label>
            <label>{{ 'products.stock_state'|trans }}<select name="stock_state"><option value="">{{ 'ui.all'|trans }}</option><option value="low" {{ stock_filters.stock_state == 'low' ? 'selected' : '' }}>{{ 'stock.low'|trans }}</option><option value="empty" {{ stock_filters.stock_state == 'empty' ? 'selected' : '' }}>{{ 'stock.empty'|trans }}</option></select></label>
            <label>{{ 'ui.active_record'|trans }}<select name="state"><option value="all">{{ 'ui.all'|trans }}</option><option value="active" {{ stock_filters.state == 'active' ? 'selected' : '' }}>{{ 'state.active'|trans }}</option><option value="inactive" {{ stock_filters.state == 'inactive' ? 'selected' : '' }}>{{ 'state.inactive'|trans }}</option></select></label>
            <button class="btn btn-dark" type="submit">{{ 'ui.filter'|trans }}</button>
        </form>
        <div class="row-actions">
            <a class="btn btn-primary" href="{{ path('app_stock_export_excel', app.request.query.all) }}">{{ 'stock.export_excel'|trans }}</a>
            <a class="btn btn-primary" target="_blank" href="{{ path('app_stock_export_pdf', app.request.query.all) }}">{{ 'stock.export_pdf'|trans }}</a>
        </div>
    </section>

    <section class="panel">
        <form action="{{ path('app_stock_in') }}" method="post" class="form-grid stock-form">
            <label>{{ 'products.product'|trans }}
                <select name="product_id" required data-combobox>
                    {% for product in products %}
                        {% set product_ref = product.ref_company ?: (product.ref_universal ?: product.sku) %}
                        <option value="{{ product.id }}" data-search="{{ (product.ref_company ~ ' ' ~ product.ref_universal ~ ' ' ~ product.sku ~ ' ' ~ product.name)|lower }}" {{ stock_focus|default(0) == product.id ? 'selected' : '' }}>[{{ product_ref }}] {{ product.name }} - {{ product.stock_qty }}</option>
                    {% endfor %}
                </select>
            </label>
            <label>{{ 'stock.supplier'|trans }}
                <select name="supplier_id" data-combobox data-combobox-min="10">
                    <option value="">{{ 'ui.none'|trans }}</option>
                    {% for supplier in suppliers %}
                        <option value="{{ supplier.id }}" data-search="{{ supplier.name|lower }}">{{ supplier.name }}</option>
                    {% endfor %}
                </select>
            </label>
            <label>{{ 'stock.quantity'|trans }}<input name="quantity" type="number" step="1" min="1" value="1" required></label>
            <label>{{ 'stock.unit_cost'|trans }}<input name="unit_cost" type="number" step="0.01" min="0"></label>
            <label>{{ 'stock.note'|trans }}<input name="note"></label>
            <button class="btn btn-primary" type="submit">{{ 'ui.update'|trans }}</button>
        </form>
    </section>

    {% if can('stock.adjust', user) %}
        <section class="panel">
            <h2>{{ 'stock.adjust_title'|trans }}</h2>
            <form action="{{ path('app_stock_adjust') }}" method="post" class="form-grid">
                <input type="hidden" name="_token" value="{{ stock_adjust_token }}">
                <label>{{ 'products.product'|trans }}
                    <select name="product_id" required data-combobox>
                        {% for product in products %}
                            {% if product.product_type|default('stockable') != 'service' %}
                                {% set product_ref = product.ref_company ?: (product.ref_universal ?: product.sku) %}
                                <option value="{{ product.id }}" data-search="{{ (product.ref_company ~ ' ' ~ product.ref_universal ~ ' ' ~ product.sku ~ ' ' ~ product.name)|lower }}">[{{ product_ref }}] {{ product.name }} - {{ product.stock_qty }}</option>
                            {% endif %}
                        {% endfor %}
                    </select>
                </label>
                <label>{{ 'stock.real_quantity'|trans }}<input name="real_quantity" type="number" min="0" step="1" required></label>
                <label>{{ 'stock.adjust_reason'|trans }}<input name="reason" required placeholder="{{ 'stock.adjust_reason_placeholder'|trans }}"></label>
                <button class="btn btn-primary" type="submit">{{ 'stock.adjust_submit'|trans }}</button>
            </form>
        </section>
    {% endif %}

    <section class="panel">
        <div class="data-table">
            <div class="table-head"><span>{{ 'products.product'|trans }}</span><span>{{ 'stock.current'|trans }}</span><span>{{ 'ui.status'|trans }}</span><span>{{ 'ui.actions'|trans }}</span></div>
            {% for product in stock_rows|default(products) %}
                <div>
                    <strong>{{ product.name }}<br><small>{{ product.sku }}</small></strong>
                    <span>{{ product.stock_qty }}</span>
                    <span>{{ product.stock_qty <= 0 ? 'stock.empty'|trans : (product.min_qty > 0 and product.stock_qty <= product.min_qty ? 'stock.low'|trans : 'stock.available'|trans) }}</span>
                    <span class="row-actions">
                        {% include 'app/_action_button.html.twig' with {
                            label: 'stock.adjust_short'|trans,
                            url: path('app_product_show', {id: product.id}),
                            active: can('stock.adjust', user),
                            user: user,
                            reason: 'access.stock_locked'|trans
                        } only %}
                        {% include 'app/_action_button.html.twig' with {
                            label: 'products.movements'|trans,
                            url: path('app_product_show', {id: product.id}),
                            active: can('stock.adjust', user),
                            user: user,
                            reason: 'access.stock_locked'|trans
                        } only %}
                    </span>
                </div>
            {% endfor %}
        </div>
    </section>
</main>
{% endblock %}
