{% extends 'base.html.twig' %}

{% block title %}{{ 'nav.dashboard'|trans }} - SIM Auto{% endblock %}

{% block body %}
{% include 'app/_topbar.html.twig' with {user: user} %}

<main class="main-board compact-board">
    {% include 'app/_flashes.html.twig' %}

    {% set critical_count = critical_stock_count|default(critical_stock_products|default([])|length) %}
    <section class="home-grid">
        <a class="home-card tone-yellow" href="{{ path('app_products') }}">
            <span>01</span>
            <strong>{{ 'dashboard.products'|trans }}</strong>
            <small>{{ 'dashboard.products_count'|trans({'%count%': products|length}) }}</small>
        </a>
        <a class="home-card tone-black" href="{{ path('app_stock') }}">
            <span>02</span>
            <strong>
                {{ 'dashboard.stock'|trans }}
                {% if critical_count > 0 %}<em class="dashboard-badge">{{ critical_count }}</em>{% endif %}
            </strong>
            <small>{{ 'dashboard.stock_hint'|trans }}</small>
        </a>
        <a class="home-card tone-red" href="{{ path('app_operations') }}">
            <span>03</span>
            <strong>{{ 'dashboard.operations'|trans }}</strong>
            <small>{{ 'dashboard.operations_hint'|trans }}</small>
        </a>
        <a class="home-card tone-gold" href="{{ path('app_billing') }}">
            <span>04</span>
            <strong>{{ 'dashboard.billing'|trans }}</strong>
            <small>{{ 'dashboard.operations_count'|trans({'%count%': operations|length}) }}</small>
        </a>
        <button
            class="home-card home-card-button {{ critical_count > 0 ? 'tone-critical' : 'tone-healthy' }}"
            type="button"
            data-critical-stock-toggle
            aria-expanded="false"
            aria-controls="critical-stock-panel"
            onclick="const panel=document.getElementById('critical-stock-panel');const open=this.getAttribute('aria-expanded')==='true';this.setAttribute('aria-expanded',open?'false':'true');if(panel)panel.hidden=open;"
        >
            <span>05</span>
            <strong>{{ 'dashboard.critical_stock'|trans }} <em class="dashboard-badge {{ critical_count > 0 ? 'dashboard-badge-danger' : 'dashboard-badge-ok' }}">{{ critical_count }}</em></strong>
            <small>{{ critical_count > 0 ? 'dashboard.stock_alert_title'|trans({'%count%': critical_count}) : 'dashboard.stock_healthy'|trans }}</small>
        </button>
    </section>

    <section class="critical-stock-panel" id="critical-stock-panel" data-critical-stock-panel hidden>
        {% if critical_count > 0 %}
            <div class="critical-stock-list">
                {% for product in critical_stock_products %}
                    <div class="critical-stock-row">
                        <span class="badge {{ product.stock_qty <= 0 ? 'badge-stock-empty' : 'badge-stock-low' }}">
                            {{ product.stock_qty <= 0 ? 'stock.empty'|trans : 'stock.low'|trans }}
                        </span>
                        <a class="critical-stock-product" href="{{ path('app_product_show', {id: product.id}) }}">
                            <strong>{{ product.name }}</strong>
                            <small>{{ product.ref_company ?: product.sku }}</small>
                        </a>
                        <span>{{ 'stock.current'|trans }}: {{ product.stock_qty }}</span>
                        <span>{{ 'stock.minimum'|trans }}: {{ product.min_qty }}</span>
                        <a class="critical-stock-restock" href="{{ path('app_stock', {product: product.id}) }}">{{ 'dashboard.stock_alert_restock_link'|trans }}</a>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <p class="empty-state">{{ 'dashboard.stock_healthy'|trans }}</p>
        {% endif %}
    </section>
</main>
{% endblock %}
