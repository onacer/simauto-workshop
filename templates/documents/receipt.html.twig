<!doctype html>
<html lang="fr" dir="ltr"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ operation.document_no }} - SIM Auto</title>
<style>
@page { size: 80mm auto; margin: 0; }
* { box-sizing: border-box; }
html, body { width: 80mm; margin: 0; padding: 0; background: #fff; color: #000; }
body { font: 11px/1.25 "Courier New", monospace; }
.ticket-actions { display: flex; gap: 4px; padding: 2mm; }
.ticket-actions a, .ticket-actions button { padding: 5px; border: 1px solid #111; background: #fff; color: #111; text-decoration: none; }
.receipt-ticket { width: 80mm; margin: 0; padding: 2mm; overflow: hidden; page-break-inside: avoid; break-inside: avoid; }
.receipt-ticket img { display: block; width: 25mm; max-height: 16mm; object-fit: contain; margin: 0 auto 1mm; }
h1, p { margin: 1mm 0; text-align: center; } h1 { font-size: 17px; }
hr { border: 0; border-top: 1px dashed #111; margin: 2mm 0; }
.receipt-row, .receipt-total, .ticket-line { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2mm; margin-bottom: 1mm; }
.receipt-row b, .ticket-line span { min-width: 0; overflow-wrap: anywhere; }
.ticket-line small { grid-column: 1; } .ticket-line b { grid-column: 2; text-align: right; }
.receipt-total { align-items: center; font-size: 15px; font-weight: bold; }
.money, .numeric { direction: ltr; unicode-bidi: isolate; display: inline-block; white-space: nowrap; }
.thanks { direction: rtl; font-family: Arial, sans-serif; font-weight: bold; }
@media print {
  html, body { width: 80mm; margin: 0 !important; padding: 0 !important; }
  .ticket-actions { display: none !important; }
  .receipt-ticket { width: 80mm; margin: 0; padding: 2mm; page-break-inside: avoid; break-inside: avoid; }
}
</style></head><body>
<nav class="ticket-actions"><a href="{{ path('app_operation_show', {id: operation.id}) }}">{{ 'ui.back'|trans }}</a><button type="button" onclick="window.print()">{{ 'documents.print'|trans }}</button></nav>
<main class="receipt-ticket">
<img src="{{ asset('images/logo-invoice.png') }}" alt="SIM Auto"><h1>SIM AUTO</h1><p>{{ company.service_line_1 }}</p><p>{{ company.address }}</p><hr>
<p class="numeric">N° {{ operation.document_no }}</p>
<div class="receipt-row"><span>{{ 'ui.date'|trans }}</span><b class="numeric">{{ operation.created_at|date('d/m/Y H:i') }}</b></div>
<div class="receipt-row"><span>{{ 'ui.client'|trans }}</span><b>{{ operation.client_real_name ?: operation.client_name }}</b></div>
<div class="receipt-row"><span>{{ 'vehicles.vehicle'|trans }}</span><b>{{ operation.brand_name ?: operation.vehicle_brand }} {{ operation.model_name ?: operation.vehicle_model }}</b></div>
<div class="receipt-row"><span>{{ 'vehicles.plate'|trans }}</span><b class="numeric">{{ operation.vehicle_real_plate ?: operation.vehicle_plate }}</b></div><hr>
{% for item in operation.items %}<div class="ticket-line"><span>{% if item.product_sku %}{{ item.product_sku }} - {% endif %}{{ item.label }}</span><small class="numeric">{{ item.quantity }} × {{ item.unit_price|money(0) }}</small><b>{{ item.total|money(0) }}</b></div>{% endfor %}
<hr><div class="receipt-total"><span>{{ 'operations.total'|trans }}</span><strong>{{ operation.total_ttc|default(operation.total)|money(0) }}</strong></div>
<div class="receipt-row"><span>{{ 'operations.payment'|trans }}</span><b>{{ operation.payment_label }}</b></div>
{% if operation.check_number %}<div class="receipt-row"><span>{{ 'operations.check_number'|trans }}</span><b>{{ operation.check_number }}</b></div>{% endif %}
<hr><p class="thanks">Merci pour votre visite<br>شكرا لزيارتكم</p><p>{{ company.contact }}</p>
</main></body></html>
