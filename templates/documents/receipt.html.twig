{% extends 'base.html.twig' %}

{% block title %}{{ operation.document_no }} - SIM Auto{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
@page { size: 80mm auto; margin: 0; }
.receipt-ticket, .receipt-ticket * { color: #000; font-family: Arial, Tahoma, sans-serif; font-size: 12px; font-weight: 700; }
.receipt-ticket { background: #fff; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
.receipt-ticket h1 { font-size: 18px; font-weight: 900; }
.receipt-ticket .receipt-total, .receipt-ticket .receipt-total * { font-size: 16px; font-weight: 900; }
@media print {
    html, body { margin: 0 !important; padding: 0 !important; background: #fff !important; }
    body * { visibility: hidden; }
    #ticket, #ticket * { visibility: visible; }
    #ticket { position: absolute; top: 0; left: 0; width: 80mm; margin: 0 auto; padding: 2mm; box-sizing: border-box; color: #000; background: #fff; font-weight: 700; box-shadow: none; page-break-inside: avoid; break-inside: avoid; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    #ticket.ticket-72mm { width: 72mm; }
    .topbar, .ticket-screen-actions { display: none !important; }
}
</style>
{% endblock %}

{% block body %}
{% include 'app/_topbar.html.twig' with {user: user} %}
<main class="main-board receipt-screen">
    <section class="page-head ticket-screen-actions">
        <h1>{{ 'billing.receipt'|trans }} — {{ operation.document_no }}</h1>
        <span class="row-actions">
            <a class="btn btn-dark" href="{{ path('app_operation_show', {id: operation.id}) }}">{{ 'ui.back'|trans }}</a>
            <button class="btn btn-primary" type="button" onclick="window.print()">{{ 'documents.print'|trans }}</button>
        </span>
    </section>

    <section id="ticket" class="receipt-ticket">
        <img src="{{ asset('images/logo-invoice.png') }}" alt="SIM Auto">
        <h1>SIM AUTO</h1><p>{{ company.service_line_1 }}</p><p>{{ company.address }}</p><hr>
        <p class="numeric">N° {{ operation.document_no }}</p>
        <div class="receipt-row"><span>{{ 'ui.date'|trans }}</span><b class="numeric">{{ operation.created_at|date('d/m/Y H:i') }}</b></div>
        <div class="receipt-row"><span>{{ 'ui.client'|trans }}</span><b>{{ operation.client_real_name ?: operation.client_name }}</b></div>
        <div class="receipt-row"><span>{{ 'vehicles.vehicle'|trans }}</span><b>{{ operation.brand_name ?: operation.vehicle_brand }} {{ operation.model_name ?: operation.vehicle_model }}</b></div>
        <div class="receipt-row"><span>{{ 'vehicles.plate'|trans }}</span><b class="numeric">{{ operation.vehicle_real_plate ?: operation.vehicle_plate }}</b></div><hr>
        {% for item in operation.items %}<div class="ticket-line"><span>{% if item.product_sku %}{{ item.product_sku }} - {% endif %}{{ item.label }}</span><small class="numeric">{{ item.quantity }} × {{ item.unit_price|money(0) }}</small><b>{{ item.total|money(0) }}</b></div>{% endfor %}
        <hr><div class="receipt-total"><span>{{ 'operations.total'|trans }}</span><strong>{{ operation.total_ttc|default(operation.total)|money(0) }}</strong></div>
        <div class="receipt-row"><span>{{ 'operations.payment'|trans }}</span><b>{{ operation.payment_label }}</b></div>
        {% if operation.check_number %}<div class="receipt-row"><span>{{ 'operations.check_number'|trans }}</span><b>{{ operation.check_number }}</b></div>{% endif %}
        <hr><p class="thanks">Merci pour votre visite<br>شكرا لزيارتكم</p><p>{{ company.contact }}</p>
    </section>
</main>
{% endblock %}
